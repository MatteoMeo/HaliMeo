HALIMEO_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
HALIMEO_OWNER_USER_ID=

# Email SMTP per il recupero password (esempio: provider SMTP del proprio indirizzo)
HALIMEO_SMTP_HOST=smtp.example.com
HALIMEO_SMTP_PORT=587
HALIMEO_SMTP_USER=your-email@example.com
HALIMEO_SMTP_PASSWORD=your-app-password
HALIMEO_SMTP_FROM=HaliMeo <your-email@example.com>
HALIMEO_SMTP_SSL=false
HALIMEO_SMTP_STARTTLS=true
